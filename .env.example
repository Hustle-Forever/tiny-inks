# ---- Demo mode ----
# "true" = site runs on built-in sample products (no Shopify needed).
# Set to "false" once your Shopify keys below are filled in.
NEXT_PUBLIC_DEMO_MODE=true

# ---- Shopify (Storefront API) ----
# Store domain, e.g. tiny-inks.myshopify.com  (no https://)
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=
# Public Storefront API access token (from the Headless sales channel)
NEXT_PUBLIC_SHOPIFY_STOREFRONT_TOKEN=
# Storefront API version (update if Shopify sunsets this one)
NEXT_PUBLIC_SHOPIFY_API_VERSION=2026-01

# ---- Business details ----
NEXT_PUBLIC_WHATSAPP_NUMBER=971500000000
NEXT_PUBLIC_INSTAGRAM_URL=https://instagram.com/tinyinks
NEXT_PUBLIC_CONTACT_EMAIL=hello@tinyinks.ae

# ---- Tiny Drops ----
# When the current drop closes / next drop lands (ISO date, Dubai time)
NEXT_PUBLIC_DROP_DATE=2026-09-01T18:00:00+04:00

# ---- Site URL (for SEO: sitemap, canonical, JSON-LD) ----
NEXT_PUBLIC_SITE_URL=https://tinyinks.ae
